# JABS snapshot agent secrets. Copy to .env (./setup.sh does it); never commit the real file.
# Settings that are not secret live in config/config.yaml.

# 'development' turns on debug logging and prefixes email subjects with [DEV].
# ENV_MODE=development

# Optional: report to a JABS dashboard. Leave both empty to run standalone.
# The key comes from `.venv/bin/python -m app agent add NAME` on the dashboard host.
JABS_DASHBOARD_URL=
JABS_AGENT_KEY=

# Uptime Kuma push-monitor URL, if used. Leave empty to disable.
UPTIME_KUMA_URL=

# Path to the restic binary; empty uses "restic" from PATH.
RESTIC_BIN=

# Restic repository password: set exactly one. A password file keeps the secret out of
# process listings.
RESTIC_PASSWORD=
RESTIC_PASSWORD_FILE=

# Cloud and remote repositories (a repo_path such as s3:, b2:, sftp:, rest: or rclone:): put the
# provider's credentials here, uncommenting only what you use. They reach restic as environment
# variables. See config/templates/job.yaml for the repo_path forms and the restic documentation
# for variables not listed.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# GOOGLE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# RESTIC_REST_USERNAME=
# RESTIC_REST_PASSWORD=

# SMTP login for immediate failure/completion emails (server and recipients are in config.yaml).
JABS_SMTP_USERNAME=
JABS_SMTP_PASSWORD=
