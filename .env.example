# JABS snapshot agent secrets. Copy to .env (./setup.sh does it); never commit the real file.
# Settings that are not secret live in config/config.yaml.

# 'development' turns on debug logging and prefixes email subjects with [DEV].
# ENV_MODE=development

# Optional: report to a JABS dashboard. Leave both empty to run standalone.
# The key comes from `python -m app agent add NAME` on the dashboard host.
JABS_DASHBOARD_URL=
JABS_AGENT_KEY=

# Uptime Kuma push-monitor URL, if used. Leave empty to disable.
UPTIME_KUMA_URL=

# Path to the restic binary; empty uses "restic" from PATH.
RESTIC_BIN=

# Restic repository password: set exactly one. A password file keeps the secret out of
# process listings.
RESTIC_PASSWORD=
RESTIC_PASSWORD_FILE=

# SMTP login for immediate failure/completion emails (server and recipients are in config.yaml).
JABS_SMTP_USER=
JABS_SMTP_PASS=
