# JABS Snapshot Agent Environment Variables
# Copy this file to '.env' and fill in your values. '.env' is gitignored and
# will never be committed.

# This will display a banner and enable debug logging.
# Uncomment the following line if codebase is in development mode
# ENV_MODE='development'

# URL:PORT for the JABS Dashboard.
JABS_DASHBOARD_URL="http://your-jabs-dashboard:5000"

# API key for this agent, generated on the dashboard's Agents page (Regenerate
# there if this ever needs to be rotated).
JABS_AGENT_KEY=""

# Uptime Kuma push-monitor URL, if used. Leave empty to disable.
UPTIME_KUMA_URL=""

# Path to the restic binary. Leave unset/empty to use "restic" from PATH
# (covers apt/dnf/pacman/Homebrew/Scoop/Chocolatey installs, and manual
# installs that were symlinked onto PATH). Only set this to an absolute path
# if restic was installed somewhere NOT on PATH (e.g. a static binary
# download extracted to a private directory), e.g.:
# RESTIC_BIN="/opt/restic/restic"
RESTIC_BIN=""

# Restic repository password. Prefer RESTIC_PASSWORD_FILE (path to a file
# containing just the password) over RESTIC_PASSWORD if the password might
# ever appear in process listings/logs. These are restic's own native env
# var names, passed straight through — set exactly one.
RESTIC_PASSWORD=""
RESTIC_PASSWORD_FILE=""

# SMTP credentials (for immediate failure/completion email notifications,
# see config/global.yaml's email.notify_on section)
JABS_SMTP_USERNAME=""
JABS_SMTP_PASSWORD=""
